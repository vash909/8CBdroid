    <instrumentation android:name=".AudioCaptureProbe" android:targetPackage="net.vash.ft8cbdroid.engineprobe" android:label="R10 microphone reference-tone check" />
    <instrumentation android:name=".AudioTimestampProbe" android:targetPackage="net.vash.ft8cbdroid.engineprobe" android:label="Capture timestamp diagnostic" />
